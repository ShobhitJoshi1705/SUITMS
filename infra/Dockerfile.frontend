# Multi-stage build for React frontend with Tailwind CSS
# --- Builder stage ---
FROM node:20-alpine AS builder
WORKDIR /app

# Install dependencies (package.json and package-lock.json are in the build context)
COPY package*.json ./
RUN npm install

# Copy source files and build the production bundle (includes Tailwind CSS)
COPY . ./
RUN npm run build

# --- Final Nginx stage ---
FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html

# Configure Nginx to serve on port 3000
RUN printf 'server {\n    listen 3000;\n    resolver 127.0.0.11 ipv6=off valid=30s;\n    set $gateway nginx;\n    location /api/ {\n        proxy_pass http://$gateway;\n        proxy_set_header Host $host;\n        proxy_set_header X-Real-IP $remote_addr;\n        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n        proxy_set_header X-Forwarded-Proto $scheme;\n    }\n    location /health/ {\n        proxy_pass http://$gateway;\n        proxy_set_header Host $host;\n        proxy_set_header X-Real-IP $remote_addr;\n        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n        proxy_set_header X-Forwarded-Proto $scheme;\n    }\n    location / {\n        root /usr/share/nginx/html;\n        index index.html;\n        try_files $uri $uri/ /index.html;\n    }\n}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 3000

CMD ["nginx", "-g", "daemon off;"]

