# SUITMS Environment Configuration Template
PROJECT_NAME="SUITMS - Smart Urban Infrastructure & Traffic Management System"
VERSION="1.0.0"
ENVIRONMENT="production"
DEBUG="false"

# API & Gateway Configuration
HOST="0.0.0.0"
PORT=8000
API_V1_PREFIX="/api/v1"
CORS_ORIGINS="*"
SECRET_KEY="suitms-production-sec-key-replace-in-env"

# Database Tier (HA PostgreSQL Cluster)
DATABASE_URL="postgresql://suitms_user:suitms_secure_pass_2026@postgres:5432/suitms_db"
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_PRE_PING=true

# Messaging & Streaming Tier (Redis Cluster / Streams)
REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0
REDIS_STREAM_VIOLATIONS="traffic:violations:stream"
REDIS_STREAM_HAZARDS="traffic:hazards:stream"
REDIS_CONSUMER_GROUP="suitms-workers"

# Object Storage Tier (MinIO S3-Compatible)
S3_ENDPOINT="http://minio:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin123"
S3_BUCKET_ARTIFACTS="suitms-artifacts"
S3_BUCKET_HAZARDS="suitms-hazards"
LOCAL_STORAGE_DIR="./storage_data"

# Edge Node Spooling Configuration
SPOOL_DIR="./edge_spool"
MAX_SPOOL_SIZE_MB=500
